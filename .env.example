# Supabase PostgreSQL Configuration
# The HTTPS URL of your Supabase project (found in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Privileged Supabase Service Role Key (Secret)
# IMPORTANT: Must be the 'service_role' secret key, NEVER the 'anon' public key.
# Used exclusively on the server for secure database operations without RLS 42501 errors.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Administrative Access Key
# Required to access /admin and approve, generate, and release 30-day timetables to users.
AURAMIND_ADMIN_KEY=your-secure-admin-passphrase

# Google Gemini AI Configuration
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=low

# Optional: Tavily API Key for External Web Research
# Used during admin research phase to pull domain milestones and curriculum benchmarks.
TAVILY_API_KEY=your-optional-tavily-key

# Google Calendar Integration (OAuth 2.0)
# OAuth client configured in Google Cloud Console with Google Calendar API enabled.
# Client ID can also fall back to GOOGLE_CLIENT_ID if sharing existing OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://auramind-vert.vercel.app/api/calendar/callback

# Token Encryption Secret (AES-256-GCM)
# 32+ character passphrase used to encrypt Google refresh tokens at rest.
# If omitted, deterministically derives from SUPABASE_SERVICE_ROLE_KEY.
CALENDAR_ENCRYPTION_SECRET=your-32-character-encryption-secret

