# Gemini is the main AI engine. Keep these server-side secrets out of NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Tavily gives AuraMind live web-search results for the research stage.
# Free plan currently includes 1,000 API credits/month and does not require a card.
TAVILY_API_KEY=

# Optional legacy OpenAI variables for future provider support.
OPENAI_API_KEY=
OPENAI_MODEL=

# Persistent request queue (server-side only; never expose the service role key in NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AURAMIND_ADMIN_KEY=
